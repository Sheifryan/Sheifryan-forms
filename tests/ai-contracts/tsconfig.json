{
  "compilerOptions": {
    "target": "ES2020",
    // "dom" is here for lib/ai/client.ts, whose fetch RequestInit uses the
    // `cache` option (present in the DOM fetch types, not in @types/node's).
    "lib": ["ES2020", "dom"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../*"]
    },
    "outDir": "dist",
    "rootDir": "../.."
  },
  "include": [
    "../../lib/ai/contracts.ts",
    "../../lib/ai/errors.ts",
    "../../lib/ai/client.ts",
    "../../lib/ai/prompts.ts",
    "../../lib/schema.ts",
    "../../lib/phone.ts",
    "./**/*.ts"
  ],
  "exclude": ["dist"]
}
