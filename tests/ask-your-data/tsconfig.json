{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../*"]
    },
    "outDir": "dist",
    "rootDir": "../.."
  },
  "include": [
    "../../lib/ai/analysis/**/*.ts",
    "../../lib/schema.ts",
    "../../lib/phone.ts",
    "./**/*.ts"
  ],
  "exclude": ["dist"]
}
