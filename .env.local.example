NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- AI form builder (DeepSeek / OpenAI-compatible chat API) ---
# Server-only. The "Create with AI", builder review and response-analysis
# features are disabled until AI_API_KEY is set.
AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# Optional: pin a specific model for reading uploaded form images.
# AI_VISION_MODEL=deepseek-chat

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# --- Email (workflow actions: email_notification / confirmation_email) ---
# Resend is called over its REST API. Without RESEND_API_KEY the email actions
# are recorded as "email is not configured" in the workflow run log rather than
# failing a submission.
RESEND_API_KEY=your_resend_api_key
# Sender for outbound mail. DEFAULT_FROM_EMAIL is the preferred name and may use
# the "Name <address>" form; SERVER_EMAIL is accepted as a fallback, and
# NOTIFY_FROM_EMAIL (the name the notify-submission Edge Function reads) still
# wins if it is set. The sending domain must be verified in Resend.
DEFAULT_FROM_EMAIL="NibbleAI <no-reply@yourdomain.com>"
SERVER_EMAIL=no-reply@yourdomain.com
# Optional: override the Resend API base (used by tests, or a proxy).
# RESEND_API_BASE=https://api.resend.com

# --- Supabase Postgres (optional; only for running migrations with psql) ---
# This is the project's DATABASE password (Supabase → Project Settings →
# Database), NOT the API keys above — the app itself never reads these two.
# The direct db.<project-ref>.supabase.co host is IPv6-only on many networks,
# so prefer the pooler: session mode, port 5432, username
# "postgres.<project-ref>" (the dashboard's connect panel lists the region).
SUPABASE_DB_PASSWORD=your-database-password
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- MarzPay (mobile-money payments) ---
# API base. Defaults to https://wallet.wearemarz.com/api/v1 when unset.

MARZPAY_API_BASE=https://wallet.wearemarz.com/api/v1
MARZPAY_API_KEY=your_marzpay_api_key
MARZPAY_API_SECRET=your_marzpay_api_secret
# Full URL of this app's webhook receiver (used as callback_url on collection initiation).
MARZPAY_CALLBACK_URL=https://sheifryan-forms.vercel.app/api/marzpay/webhook
# Optional HMAC signing secret from MarzPay's webhook settings (enables signature verification).
MARZPAY_WEBHOOK_SECRET=optional_signing_secret
