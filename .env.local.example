NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=generate-a-long-random-string

# --- MarzPay (mobile-money payments) ---
# API base. Defaults to https://wallet.wearemarz.com/api/v1 when unset.

MARZPAY_API_BASE=https://wallet.wearemarz.com/api/v1
MARZPAY_API_KEY=your_marzpay_api_key
MARZPAY_API_SECRET=your_marzpay_api_secret
# Full URL of this app's webhook receiver (used as callback_url on collection initiation).
MARZPAY_CALLBACK_URL=https://sheifryan-forms.vercel.app/api/marzpay/webhook
# Optional HMAC signing secret from MarzPay's webhook settings (enables signature verification).
MARZPAY_WEBHOOK_SECRET=optional_signing_secret
